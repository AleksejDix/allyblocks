  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build": "vite build",
    "lint": "oxlint",
    "lint:format": "prettier --write .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:browser": "vitest --config vitest.config.browser.ts",
    "test:browser:coverage": "vitest run --config vitest.config.browser.ts --coverage",
    "test:coverage": "npm run test:unit:coverage && npm run test:browser:coverage",
    "test:related": "vitest related --run --config vitest.config.ts",
    "storybook": "storybook dev -p 6006",
    "test:storybook": "vitest --config vitest.config.browser.ts",
    "test:storybook:coverage": "vitest run --config vitest.config.browser.ts --coverage",
    "build-storybook": "storybook build",
    "serve-storybook": "serve storybook-static",
    "chromatic": "npx chromatic --project-token=chpt_d5576e0120be3ac --allow-console-errors",
    "prepublishOnly": "npm run build",
    "check:bundle": "ANALYZE=1 vite build"
  },
